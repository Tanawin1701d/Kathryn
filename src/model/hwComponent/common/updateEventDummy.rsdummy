#[derive(Clone, Copy)]
pub struct Slice {}
impl Slice {
    pub fn get_size(&self) -> usize { 0 }
}

impl Operable {
    pub fn check_short_circuit(&self) -> Option<&Operable> { None }
    pub fn get_operable_slice(&self) -> Slice { Slice {} }
}

pub const DEFAULT_UE_PRI_USER: i32 = 10;
pub const DEFAULT_UE_PRI_INTERNAL_MAX: i32 = 100;
pub const DEFAULT_UE_PRI_INTERNAL_MIN: i32 = 50;
pub const DEFAULT_UE_PRI_RST: i32 = i32::MAX;
pub const DEFAULT_UE_PRI_MIN: i32 = 0;
pub const DEFAULT_UE_SUB_PRIORITY_USER: u64 = 0;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum UeType {
    Basic = 0,
    Grp = 1,
    Cond = 2,
    Switch = 3,
}

pub trait UpdateEvent {
    fn get_type(&self) -> UeType;
    fn get_priority(&self) -> i32;
    fn get_sub_priority(&self) -> u64;
    fn get_clk_mode(&self) -> CLOCK_MODE;
    fn is_leaf(&self) -> bool;

    fn set_priority(&mut self, priority: i32);
    fn set_sub_priority(&mut self, sub_priority: u64);
    fn set_clk_mode(&mut self, clk_mode: CLOCK_MODE);

    fn check_short_circuit_proxy(&self) -> Option<&Operable>;
    fn get_dep(&self, result_dep: &mut Vec<&Operable>);
    fn create_sim_event(&self) -> Box<dyn UpdateEventBaseSimEngine>;
    fn clone_event(&self) -> Box<dyn UpdateEvent>;
    fn create_gen_engine(&self) -> Box<dyn UEBaseGenEngine>;

    fn is_joinable(&self, rhs: &dyn UpdateEvent) -> bool {
        self.get_priority() == rhs.get_priority() && self.get_clk_mode() == rhs.get_clk_mode()
    }
}

#[derive(Clone)]
pub struct UpdateEventBaseData {
    pub ue_type: UeType,
    pub is_leaf: bool,
    pub priority: i32,
    pub sub_priority: u64,
    pub clk_mode: CLOCK_MODE,
}

impl UpdateEventBaseData {
    pub fn new(ue_type: UeType, is_leaf: bool) -> Self {
        Self {
            ue_type,
            is_leaf,
            priority: DEFAULT_UE_PRI_MIN,
            sub_priority: DEFAULT_UE_SUB_PRIORITY_USER,
            clk_mode: CLOCK_MODE::CM_CLK_UNUSED,
        }
    }
}

#[derive(Clone)]
pub struct UpdateEventBasic {
    pub base: UpdateEventBaseData,
    pub value: Box<Operable>,
    pub des_slice: Slice,
}

impl UpdateEventBasic {
    pub fn new(value: Box<Operable>, slice: Slice, priority: i32, clk_mode: CLOCK_MODE) -> Self {
        Self {
            base: UpdateEventBaseData {
                ue_type: UeType::Basic,
                is_leaf: true,
                priority,
                sub_priority: DEFAULT_UE_SUB_PRIORITY_USER,
                clk_mode,
            },
            value,
            des_slice: slice,
        }
    }
}

impl UpdateEvent for UpdateEventBasic {
    fn get_type(&self) -> UeType { self.base.ue_type }
    fn get_priority(&self) -> i32 { self.base.priority }
    fn get_sub_priority(&self) -> u64 { self.base.sub_priority }
    fn get_clk_mode(&self) -> CLOCK_MODE { self.base.clk_mode }
    fn is_leaf(&self) -> bool { self.base.is_leaf }

    fn set_priority(&mut self, priority: i32) { self.base.priority = priority; }
    fn set_sub_priority(&mut self, sub_priority: u64) { self.base.sub_priority = sub_priority; }
    fn set_clk_mode(&mut self, clk_mode: CLOCK_MODE) { self.base.clk_mode = clk_mode; }

    fn check_short_circuit_proxy(&self) -> Option<&Operable> {
        self.value.check_short_circuit()
    }

    fn get_dep(&self, result_dep: &mut Vec<&Operable>) {
        result_dep.push(&self.value);
    }

    fn create_sim_event(&self) -> Box<dyn UpdateEventBaseSimEngine> {
        Box::new(UpdateEventBasicSimEngineImpl::new(self))
    }

    fn clone_event(&self) -> Box<dyn UpdateEvent> {
        Box::new(self.clone())
    }

    fn create_gen_engine(&self) -> Box<dyn UEBaseGenEngine> {
        Box::new(UEBasicGenEngineImpl::new(self))
    }
}

#[derive(Clone)]
pub struct UpdateEventGrp {
    pub base: UpdateEventBaseData,
    pub sub_stmts: Vec<Box<dyn UpdateEvent>>,
}

impl UpdateEventGrp {
    pub fn new() -> Self {
        Self {
            base: UpdateEventBaseData::new(UeType::Grp, false),
            sub_stmts: Vec::new(),
        }
    }

    pub fn add_sub_stmt(&mut self, stmt: Box<dyn UpdateEvent>) {
        if self.sub_stmts.is_empty() {
            self.base.priority = stmt.get_priority();
            self.base.clk_mode = stmt.get_clk_mode();
        }
        self.sub_stmts.push(stmt);
    }
}

impl UpdateEvent for UpdateEventGrp {
    fn get_type(&self) -> UeType { self.base.ue_type }
    fn get_priority(&self) -> i32 { self.base.priority }
    fn get_sub_priority(&self) -> u64 { self.base.sub_priority }
    fn get_clk_mode(&self) -> CLOCK_MODE { self.base.clk_mode }
    fn is_leaf(&self) -> bool { self.base.is_leaf }

    fn set_priority(&mut self, priority: i32) { self.base.priority = priority; }
    fn set_sub_priority(&mut self, sub_priority: u64) { self.base.sub_priority = sub_priority; }
    fn set_clk_mode(&mut self, clk_mode: CLOCK_MODE) { self.base.clk_mode = clk_mode; }

    fn check_short_circuit_proxy(&self) -> Option<&Operable> {
        for stmt in &self.sub_stmts {
            if let Some(result) = stmt.check_short_circuit_proxy() {
                return Some(result);
            }
        }
        None
    }

    fn get_dep(&self, result_dep: &mut Vec<&Operable>) {
        for stmt in &self.sub_stmts {
            stmt.get_dep(result_dep);
        }
    }

    fn create_sim_event(&self) -> Box<dyn UpdateEventBaseSimEngine> {
        Box::new(UpdateEventGrpSimEngineImpl::new(self))
    }

    fn clone_event(&self) -> Box<dyn UpdateEvent> {
        Box::new(Self {
            base: self.base.clone(),
            sub_stmts: self.sub_stmts.iter().map(|s| s.clone_event()).collect(),
        })
    }

    fn create_gen_engine(&self) -> Box<dyn UEBaseGenEngine> {
        Box::new(UEGrpGenEngineImpl::new(self))
    }
}

#[derive(Clone)]
pub struct UpdateEventCond {
    pub base: UpdateEventBaseData,
    pub is_last_occure: bool,
    pub conditions: Vec<Option<Box<Operable>>>,
    pub sub_stmts: Vec<Box<dyn UpdateEvent>>,
}

impl UpdateEventCond {
    pub fn new() -> Self {
        Self {
            base: UpdateEventBaseData::new(UeType::Cond, false),
            is_last_occure: false,
            conditions: Vec::new(),
            sub_stmts: Vec::new(),
        }
    }

    pub fn add_sub_stmt(&mut self, cond: Option<Box<Operable>>, stmt: Box<dyn UpdateEvent>) {
        assert!(!self.is_last_occure);
        if cond.is_none() {
            self.is_last_occure = true;
        }
        if self.sub_stmts.is_empty() {
            self.base.priority = stmt.get_priority();
            self.base.clk_mode = stmt.get_clk_mode();
        }
        self.conditions.push(cond);
        self.sub_stmts.push(stmt);
    }
}

impl UpdateEvent for UpdateEventCond {
    fn get_type(&self) -> UeType { self.base.ue_type }
    fn get_priority(&self) -> i32 { self.base.priority }
    fn get_sub_priority(&self) -> u64 { self.base.sub_priority }
    fn get_clk_mode(&self) -> CLOCK_MODE { self.base.clk_mode }
    fn is_leaf(&self) -> bool { self.base.is_leaf }

    fn set_priority(&mut self, priority: i32) { self.base.priority = priority; }
    fn set_sub_priority(&mut self, sub_priority: u64) { self.base.sub_priority = sub_priority; }
    fn set_clk_mode(&mut self, clk_mode: CLOCK_MODE) { self.base.clk_mode = clk_mode; }

    fn check_short_circuit_proxy(&self) -> Option<&Operable> {
        for cond in &self.conditions {
            if let Some(cond) = cond.as_ref() {
                if let Some(result) = cond.check_short_circuit() {
                    return Some(result);
                }
            }
        }

        for stmt in &self.sub_stmts {
            if let Some(result) = stmt.check_short_circuit_proxy() {
                return Some(result);
            }
        }
        None
    }

    fn get_dep(&self, result_dep: &mut Vec<&Operable>) {
        for cond in &self.conditions {
            if let Some(cond) = cond.as_ref() {
                result_dep.push(cond);
            }
        }
        for stmt in &self.sub_stmts {
            stmt.get_dep(result_dep);
        }
    }

    fn create_sim_event(&self) -> Box<dyn UpdateEventBaseSimEngine> {
        Box::new(UpdateEventCondSimEngineImpl::new(self))
    }

    fn clone_event(&self) -> Box<dyn UpdateEvent> {
        Box::new(Self {
            base: self.base.clone(),
            is_last_occure: self.is_last_occure,
            conditions: self.conditions.iter().map(|c| c.as_ref().map(|x| x.clone())).collect(),
            sub_stmts: self.sub_stmts.iter().map(|s| s.clone_event()).collect(),
        })
    }

    fn create_gen_engine(&self) -> Box<dyn UEBaseGenEngine> {
        Box::new(UECondGenEngineImpl::new(self))
    }
}

#[derive(Clone)]
pub struct UpdateEventSwitch {
    pub base: UpdateEventBaseData,
    pub is_init_meta: bool,
    pub state_iden: Box<Operable>,
    pub sub_stmt_idxs: Vec<i32>,
    pub sub_stmts: Vec<Option<Box<dyn UpdateEvent>>>,
}

impl UpdateEventSwitch {
    pub fn new(state_iden: Box<Operable>) -> Self {
        Self {
            base: UpdateEventBaseData::new(UeType::Switch, false),
            is_init_meta: false,
            state_iden,
            sub_stmt_idxs: Vec::new(),
            sub_stmts: Vec::new(),
        }
    }

    pub fn get_max_idx(&self) -> i32 {
        1 << self.state_iden.get_operable_slice().get_size()
    }

    pub fn get_match_num(&self) -> usize {
        assert_eq!(self.sub_stmt_idxs.len(), self.sub_stmts.len());
        self.sub_stmt_idxs.len()
    }

    pub fn add_sub_stmt(&mut self, match_val: i32, stmt: Option<Box<dyn UpdateEvent>>) {
        assert!(match_val >= -1 && match_val < self.get_max_idx());
        if !self.is_init_meta {
            if let Some(ref s) = stmt {
                self.base.priority = s.get_priority();
                self.base.clk_mode = s.get_clk_mode();
                self.is_init_meta = true;
            }
        }
        self.sub_stmt_idxs.push(match_val);
        self.sub_stmts.push(stmt);
    }
}

impl UpdateEvent for UpdateEventSwitch {
    fn get_type(&self) -> UeType { self.base.ue_type }
    fn get_priority(&self) -> i32 { self.base.priority }
    fn get_sub_priority(&self) -> u64 { self.base.sub_priority }
    fn get_clk_mode(&self) -> CLOCK_MODE { self.base.clk_mode }
    fn is_leaf(&self) -> bool { self.base.is_leaf }

    fn set_priority(&mut self, priority: i32) { self.base.priority = priority; }
    fn set_sub_priority(&mut self, sub_priority: u64) { self.base.sub_priority = sub_priority; }
    fn set_clk_mode(&mut self, clk_mode: CLOCK_MODE) { self.base.clk_mode = clk_mode; }

    fn check_short_circuit_proxy(&self) -> Option<&Operable> {
        if let Some(result) = self.state_iden.check_short_circuit() {
            return Some(result);
        }

        for stmt in &self.sub_stmts {
            if let Some(stmt) = stmt.as_ref() {
                if let Some(result) = stmt.check_short_circuit_proxy() {
                    return Some(result);
                }
            }
        }
        None
    }

    fn get_dep(&self, result_dep: &mut Vec<&Operable>) {
        result_dep.push(&self.state_iden);
        for stmt in &self.sub_stmts {
            if let Some(stmt) = stmt.as_ref() {
                stmt.get_dep(result_dep);
            }
        }
    }

    fn create_sim_event(&self) -> Box<dyn UpdateEventBaseSimEngine> {
        Box::new(UpdateEventSwitchSimEngineImpl::new(self))
    }

    fn clone_event(&self) -> Box<dyn UpdateEvent> {
        Box::new(Self {
            base: self.base.clone(),
            is_init_meta: self.is_init_meta,
            state_iden: self.state_iden.clone(),
            sub_stmt_idxs: self.sub_stmt_idxs.clone(),
            sub_stmts: self.sub_stmts.iter().map(|s| s.as_ref().map(|x| x.clone_event())).collect(),
        })
    }

    fn create_gen_engine(&self) -> Box<dyn UEBaseGenEngine> {
        Box::new(UESwitchGenEngineImpl::new(self))
    }
}

pub fn compare_ue(lhs: &dyn UpdateEvent, rhs: &dyn UpdateEvent) -> bool {
    lhs.get_priority() == rhs.get_priority()
        && lhs.get_sub_priority() == rhs.get_sub_priority()
        && lhs.get_clk_mode() == rhs.get_clk_mode()
}